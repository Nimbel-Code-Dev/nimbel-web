{
  "buildCommand": "pnpm test && pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/en/about", "destination": "/en/about-nimbel-code/", "statusCode": 301 },
    { "source": "/testimonials/pol-margaix", "destination": "/#testimonial-card-pol-margaix", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}

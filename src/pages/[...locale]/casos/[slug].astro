---
import { getCollection } from "astro:content";
import CasePage from "@/components/CasePage.astro";

// /casos/<slug>/: casos en español (src/content/casos/es/)
export async function getStaticPaths() {
  const casos = await getCollection("casos", (caso) => caso.id.startsWith("es/"));
  return casos.map((caso) => ({
    params: { locale: undefined, slug: caso.id.split("/")[1] },
    props: { caso },
  }));
}

const { caso } = Astro.props;
---

<CasePage caso={caso} locale="es" />

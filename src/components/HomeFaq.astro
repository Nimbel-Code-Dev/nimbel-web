---
import { homeEs } from "@/i18n/home-es";

// Solo ES de momento: el contenido sale de home-es.ts (y el FAQPage del JSON-LD también)
const { title, items } = homeEs.faq;
---

<section id="faq" class="w-full bg-nimbel-bg py-16 sm:py-20 lg:py-24 border-t border-white/10">
  <div class="mx-auto w-full max-w-3xl px-6">
    <h2
      class="font-mortend text-sm sm:text-base uppercase tracking-widest text-nimbel-eyebrow mb-10 sm:mb-14"
    >
      {title}
    </h2>
    {
      items.map((item) => (
        <div class="mb-10 last:mb-0">
          <h3 class="font-bold text-nimbel-text text-lg sm:text-xl mb-3">
            {item.question}
          </h3>
          <p class="text-nimbel-muted text-base leading-relaxed">{item.answer}</p>
        </div>
      ))
    }
  </div>
</section>

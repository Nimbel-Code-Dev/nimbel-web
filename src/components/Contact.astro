---
import { useTranslations, type Locale } from "@/i18n/utils";
import ContactForm from "@/components/ContactForm";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const headline = t("contact", "headline") as string;
const headlineHighlight = t("contact", "headlineHighlight") as string;
const description = t("contact", "description") as string;
const form = t("contact", "form") as {
  name: string;
  email: string;
  message: string;
  submit: string;
  sending: string;
};
const contactOptions = t("contact", "contactOptions") as ReadonlyArray<{
  type: string;
  label: string;
  sublabel: string;
}>;
const successData = t("contact", "success") as { title: string; message: string };
const formErrors = t("form", "errors") as {
  name: { required: string; minLength: string; maxLength: string; pattern: string };
  email: { required: string; email: string };
  message: { required: string; minLength: string; maxLength: string };
};

// Flatten errors for FormValidator message map: "name.required", "email.email", etc.
const flatMessages: Record<string, string> = {};
for (const [field, rules] of Object.entries(formErrors)) {
  for (const [rule, msg] of Object.entries(rules as Record<string, string>)) {
    flatMessages[`${field}.${rule}`] = msg;
  }
}

function highlightText(text: string, word: string, className: string): string {
  const regex = new RegExp(`(${word})`, "gi");
  return text.replace(regex, `<span class="${className}">$1</span>`);
}

const highlightedHeadline = highlightText(
  headline,
  headlineHighlight,
  "text-nimbel-accent"
);

const contactLinks: Record<string, string> = {
  email: "mailto:ruben@nimbel.net",
  call: "#",
  linkedin: "https://www.linkedin.com/company/nimbel",
};
---

<section
  id="contact"
  class="w-full bg-nimbel-text py-16 sm:py-20 lg:py-24"
>
  <div class="mx-auto w-full max-w-7xl px-6 sm:px-12 lg:px-16">
    <!-- Headline -->
    <h2
      class="font-mortend text-4xl sm:text-5xl lg:text-6xl uppercase text-nimbel-bg leading-tight mb-4"
      set:html={highlightedHeadline}
    />

    <!-- Description -->
    <p class="text-gray-600 text-sm sm:text-base max-w-2xl mb-10 sm:mb-14">
      {description}
    </p>

    <!-- 2-column grid -->
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-16">
      <!-- Left: Form -->
      <div class="w-full lg:w-1/2">
        <ContactForm
          client:load
          locale={locale}
          messages={flatMessages}
          labels={{
            name: form.name,
            email: form.email,
            message: form.message,
            submit: form.submit,
            sending: form.sending,
          }}
          successTitle={successData.title}
          successMessage={successData.message}
        />
      </div>

      <!-- Right: Contact options -->
      <div class="w-full lg:w-1/2 flex flex-col gap-5">
        {
          contactOptions.map((option) => (
            <a
              href={contactLinks[option.type] ?? "#"}
              target={option.type === "linkedin" ? "_blank" : undefined}
              rel={option.type === "linkedin" ? "noopener noreferrer" : undefined}
              class="flex items-start gap-4 border border-nimbel-bg/20 rounded-xl p-5 sm:p-6 hover:border-nimbel-accent transition-colors group"
            >
              <!-- Icon container -->
              <div class="shrink-0 bg-nimbel-accent rounded-md p-3 flex items-center justify-center">
                {option.type === "email" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="white"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="w-6 h-6"
                    aria-hidden="true"
                  >
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                    <polyline points="22,4 12,13 2,4" />
                  </svg>
                )}
                {option.type === "call" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="white"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="w-6 h-6"
                    aria-hidden="true"
                  >
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.62 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                )}
                {option.type === "linkedin" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="white"
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-6 h-6"
                    aria-hidden="true"
                  >
                    <path d="M7.17532 20.091V9.25352H3.69V20.091H7.17532ZM5.43339 7.773C6.64839 7.773 7.4047 6.942 7.4047 5.901C7.38294 4.8375 6.64984 4.029 5.45662 4.029C4.26339 4.029 3.48387 4.839 3.48387 5.901C3.48387 6.942 4.24016 7.773 5.41016 7.773H5.43339ZM12.5579 20.091V14.0385C12.5579 13.7145 12.5811 13.3905 12.674 13.1595C12.9252 12.513 13.4985 11.8425 14.4624 11.8425C15.7239 11.8425 16.2276 12.8355 16.2276 14.2935V20.091H19.7129V13.875C19.7129 10.545 17.9942 8.99704 15.7006 8.99704C13.8513 8.99704 13.0224 10.047 12.5579 10.7865V10.824H12.5347L12.5579 10.7865V9.25352H9.07401C9.1176 10.2705 9.07401 20.091 9.07401 20.091H12.5579Z" />
                  </svg>
                )}
              </div>

              <!-- Text -->
              <div class="flex flex-col gap-1">
                <p class="font-bold text-nimbel-bg text-lg uppercase">
                  {option.label}
                </p>
                <p class="text-gray-500 text-sm">{option.sublabel}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

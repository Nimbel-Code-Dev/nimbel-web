---
import { useTranslations, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const headline = t("contact", "headline") as string;
const headlineHighlight = t("contact", "headlineHighlight") as string;
const description = t("contact", "description") as string;
const contactOptions = t("contact", "contactOptions") as ReadonlyArray<{
  icon: string;
  label: string;
  sublabel: string;
  href: string;
  external: boolean;
}>;

function highlightText(text: string, word: string, className: string): string {
  const regex = new RegExp(`(${word})`, "gi");
  return text.replace(regex, `<span class="${className}">$1</span>`);
}

const highlightedHeadline = highlightText(
  headline,
  headlineHighlight,
  "text-nimbel-accent"
);
---

<section
  id="contact"
  class="w-full bg-nimbel-text py-16 sm:py-20 lg:py-24"
>
  <div class="mx-auto w-full max-w-7xl px-6 sm:px-12 lg:px-16">
    <!-- Headline -->
    <h2
      class="font-mortend text-4xl sm:text-5xl lg:text-6xl font-bold text-center uppercase text-nimbel-bg leading-tight mb-4"
      set:html={highlightedHeadline}
    />

    <!-- Description -->
    <p class="text-gray-600 text-sm sm:text-base text-center mb-10 sm:mb-14">
      {description}
    </p>

    <!-- 2-column grid -->
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-16">
      <!-- Left: Calendly widget -->
      <div class="w-full lg:w-1/2">
        <div
          class="calendly-inline-widget w-full rounded-lg overflow-hidden"
          data-url="https://calendly.com/ruben-nimbel/meeting?hide_event_type_details=1"
          style="min-width:320px;height:700px;"
        ></div>
      </div>

      <!-- Right: Contact options -->
      <div class="w-full lg:w-1/2 flex flex-col gap-5">
        {
          contactOptions.map((option) => (
            <a
              href={option.href}
              target={option.external ? "_blank" : undefined}
              rel={option.external ? "noopener noreferrer" : undefined}
              class="flex items-start gap-4 border border-nimbel-bg/20 p-5 sm:p-10 hover:border-nimbel-accent transition-colors group"
            >
              <img src={option.icon} alt="" aria-hidden="true" class="w-10 h-10 shrink-0" />

              <!-- Text -->
              <div class="flex flex-col gap-1">
                <p class="font-bold text-nimbel-bg text-lg uppercase">
                  {option.label}
                </p>
                <p class="text-gray-500 text-sm">{option.sublabel}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>

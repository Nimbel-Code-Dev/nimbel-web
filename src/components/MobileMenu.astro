---
import { useTranslations, type Locale } from "@/i18n/utils";

export type Props = {
  navLinks: Array<{ label: string; href: string }>;
  locale: Locale;
};

const { navLinks, locale } = Astro.props;
const t = useTranslations(locale);

const pathname = Astro.url.pathname;
const alternateUrl =
  locale === "es"
    ? `/en${pathname === "/" ? "" : pathname}`
    : pathname.replace(/^\/en/, "") || "/";
---

<div
  id="mobile-menu"
  class="hidden md:hidden flex-col items-start gap-2 bg-nimbel-bg px-6 pb-6 border-t border-nimbel-muted/10"
>
  {
    navLinks.map((link) => (
      <a
        href={link.href}
        class="text-nimbel-muted text-base py-3 w-full border-b border-nimbel-muted/10"
        aria-current={link.href === "#" ? "page" : undefined}
      >
        {link.label}
      </a>
    ))
  }
  <a href="/agenda" class="btn-secondary mt-2">
    {t("navbar", "cta")}
  </a>
  <!-- Language switcher -->
  <div class="flex items-center gap-2 pt-2 text-sm font-medium" aria-label="Cambiar idioma">
    {locale === "es" ? (
      <span class="text-nimbel-text" aria-current="true">ES</span>
    ) : (
      <a href={alternateUrl} class="text-nimbel-muted hover:text-nimbel-text transition-colors">ES</a>
    )}
    <span class="text-nimbel-muted/40">/</span>
    {locale === "en" ? (
      <span class="text-nimbel-text" aria-current="true">EN</span>
    ) : (
      <a href={alternateUrl} class="text-nimbel-muted hover:text-nimbel-text transition-colors">EN</a>
    )}
  </div>
</div>

<script>
  import { initMobileMenu } from "@/scripts/mobileMenu";

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      initMobileMenu();
    });
  } else {
    initMobileMenu();
  }
</script>

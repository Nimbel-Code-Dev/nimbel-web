---
import { homeEs } from "@/i18n/home-es";

// Solo ES de momento: el contenido sale de home-es.ts
const { title, lead, intro, items } = homeEs.audience;
---

<section id="para-quien" class="w-full bg-nimbel-bg py-16 sm:py-20 lg:py-24">
  <div class="mx-auto w-full max-w-7xl px-6 sm:px-12 lg:px-16">
    <h2
      class="font-mortend text-sm sm:text-base uppercase tracking-widest text-nimbel-eyebrow mb-6"
    >
      {title}
    </h2>
    <p class="text-nimbel-muted text-base lg:text-lg leading-relaxed max-w-3xl mb-4">
      {lead}
    </p>
    <p class="text-nimbel-muted text-base lg:text-lg leading-relaxed max-w-3xl mb-10 sm:mb-14">
      {intro}
    </p>

    <div class="bg-nimbel-text px-4 sm:px-6 lg:px-8 py-4 sm:py-6 rounded-2xl">
      {
        items.map((item, index) => (
          <div
            class={`flex flex-col lg:flex-row gap-4 lg:gap-10 items-start py-6 sm:py-8 px-2 sm:px-4 lg:px-10${
              index < items.length - 1 ? " border-b border-nimbel-bg" : ""
            }`}
          >
            <div class="shrink-0 w-8 h-8 sm:w-10 sm:h-10">
              <svg
                viewBox="0 0 24 24"
                class="w-full h-full text-nimbel-accent"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </div>
            <h3 class="flex-1 font-mortend font-bold text-lg sm:text-xl lg:text-2xl text-nimbel-bg uppercase leading-tight">
              {item.title}
            </h3>
            <p
              class="flex-1 font-clash text-sm sm:text-base lg:text-lg text-nimbel-bg leading-normal [&_a]:underline [&_a]:hover:text-nimbel-accent"
              set:html={item.text}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

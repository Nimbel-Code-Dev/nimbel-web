---
// Solo en español: el contenido vive en home-es.ts
import { audience } from "@/i18n/home-es";
---

<section
  id="para-quien"
  class="w-full bg-nimbel-bg py-16 sm:py-20 lg:py-24"
  aria-labelledby="para-quien-title"
>
  <div class="mx-auto w-full max-w-7xl px-6 sm:px-12 lg:px-16">
    <h2
      id="para-quien-title"
      class="font-mortend text-2xl sm:text-3xl lg:text-4xl xl:text-5xl text-nimbel-text uppercase leading-tight tracking-[-0.01em] mb-6"
    >
      {audience.headline}
    </h2>

    <div
      class="max-w-3xl flex flex-col gap-4 text-nimbel-muted text-base sm:text-lg leading-relaxed mb-12 sm:mb-16"
    >
      <p>{audience.intro}</p>
      <h3 class="font-bold text-lg lg:text-xl text-nimbel-text leading-snug mt-4">
        {audience.comparison.title}
      </h3>
      {audience.comparison.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <p class="mt-4">{audience.lead}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 lg:gap-x-16 gap-y-10">
      {
        audience.items.map((item) => (
          <div class="flex flex-col lg:flex-row gap-4 border-t border-nimbel-muted/30 pt-6">
            <svg
              viewBox="0 0 24 24"
              class="shrink-0 w-8 h-8 sm:w-10 sm:h-10 text-nimbel-accent"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
            <div class="flex flex-col gap-3">
              <h3 class="font-bold text-lg lg:text-xl text-nimbel-text leading-snug">
                {item.title}
              </h3>
              <p class="text-nimbel-muted text-base leading-relaxed">
                {item.description}{item.link && (<a href={item.link.href} class="underline decoration-nimbel-accent underline-offset-4 hover:text-nimbel-accent">{item.link.label}</a>)}{item.after}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

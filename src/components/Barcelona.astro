---
import { homeEs } from "@/i18n/home-es";

// Solo ES de momento: el contenido sale de home-es.ts
const { title, text } = homeEs.barcelona;
---

<section id="barcelona" class="w-full bg-nimbel-bg py-16 sm:py-20 lg:py-24 border-t border-white/10">
  <div class="mx-auto w-full max-w-3xl px-6">
    <h2
      class="font-mortend text-sm sm:text-base uppercase tracking-widest text-nimbel-eyebrow mb-6"
    >
      {title}
    </h2>
    <p class="text-nimbel-muted text-base lg:text-lg leading-relaxed">{text}</p>
  </div>
</section>

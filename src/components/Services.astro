---
import { useTranslations, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const items = t("services", "items") as ReadonlyArray<{
  id: string;
  title: string;
  shortDesc: string;
  fullDesc: string;
}>;

const services = items.map((item) => ({
  id: item.id,
  title: item.title,
  description: item.shortDesc,
}));
---

<section
  id="services"
  class="w-full bg-nimbel-text px-4 sm:px-6 lg:px-8 py-10 sm:py-14 lg:py-20 rounded-2xl"
  aria-label={t("services", "sectionLabel") as string}
  data-testid="services-section"
>
  <div class="flex flex-col">
    {
      services.map((service, index) => (
        <div
          class={`flex flex-col lg:flex-row gap-4 lg:gap-10 items-start py-6 sm:py-8 lg:py-10 px-2 sm:px-4 lg:px-10${
            index < services.length - 1 ? " border-b border-nimbel-bg" : ""
          }`}
          data-testid={`service-row-${service.id}`}
        >
          {/* Arrow Icon */}
          <div class="flex-shrink-0 w-10 h-10 sm:w-14 sm:h-14 lg:w-20 lg:h-20">
            <svg
              viewBox="0 0 24 24"
              class="w-full h-full text-nimbel-accent"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </div>

          {/* Title */}
          <h3
            class="flex-1 font-mortend font-bold text-xl sm:text-2xl lg:text-4xl text-nimbel-bg uppercase tracking-[-0.36px] leading-tight"
            data-testid={`service-title-${service.id}`}
          >
            {service.title}
          </h3>

          {/* Description */}
          <p
            class="flex-1 font-clash text-sm sm:text-base lg:text-2xl text-nimbel-bg leading-normal"
            data-testid={`service-desc-${service.id}`}
          >
            {service.description}
          </p>
        </div>
      ))
    }
  </div>
</section>

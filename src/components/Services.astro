---
import { useTranslations, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const items = t("services", "items") as ReadonlyArray<{
  id: string;
  title: string;
  shortDesc: string;
  fullDesc: string;
}>;

const services = items.map((item) => ({
  id: item.id,
  title: item.title,
  description: item.shortDesc,
}));
---

<section
  id="services"
  class="w-full bg-[#f5f5f5] px-15 py-20 rounded-2xl"
  aria-label={t("services", "sectionLabel") as string}
  data-testid="services-section"
>
  <div class="flex flex-col">
    {
      services.map((service, index) => (
        <div
          class={`flex flex-col lg:flex-row gap-4 lg:gap-15 items-start py-10 px-4 lg:px-10${
            index < services.length - 1 ? " border-b border-[#0c1414]" : ""
          }`}
          data-testid={`service-row-${service.id}`}
        >
          {/* Arrow Icon */}
          <div class="flex-shrink-0 w-20 h-20">
            <svg
              viewBox="0 0 24 24"
              class="w-full h-full text-[#fe4819]"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </div>

          {/* Title */}
          <h3
            class="flex-1 font-mortend font-bold text-4xl text-[#0c1414] uppercase tracking-[-0.36px] leading-tight"
            data-testid={`service-title-${service.id}`}
          >
            {service.title}
          </h3>

          {/* Description */}
          <p
            class="flex-1 font-clash text-2xl text-[#0c1414] leading-normal"
            data-testid={`service-desc-${service.id}`}
          >
            {service.description}
          </p>
        </div>
      ))
    }
  </div>
</section>

---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getAsset } from "@/utils/images";
import { useTranslations, type Locale } from "@/i18n/utils";

interface Props {
  locale?: Locale;
}

const { locale = "es" } = Astro.props;
const t = useTranslations(locale);

// Los SVG se sirven desde public; los PNG pasan por el optimizador de Astro
const clients: { src: string | ImageMetadata; name: string }[] = [
  { src: "/assets/clinic-de-barcelona.svg", name: "Hospital Clínic de Barcelona" },
  { src: getAsset("clients/mediage-comunicacion.png"), name: "Mediage Comunicación" },
  { src: getAsset("clients/unimedia.png"), name: "Unimedia Tech" },
  { src: getAsset("clients/StartUB-Universitat-Barcelona.png"), name: "StartUB Universitat Barcelona" },
  { src: getAsset("clients/elmerkat.png"), name: "El Merkat" },
  { src: "/assets/innocard.svg", name: "Innocard" },
];

const logoAlt = t("clients", "logoAlt") as string;
---

<section
  class="w-full bg-nimbel-surface overflow-hidden"
  aria-label={t("clients", "ariaLabel")}
  role="region"
>
  <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 sm:gap-15 px-6 sm:px-15 py-8 sm:h-18">
    <h2 class="shrink-0 text-nimbel-bg text-2xl sm:text-3xl font-semibold uppercase sm:whitespace-nowrap font-display">
      {t("clients", "headline")}
    </h2>
    <div class="w-full sm:flex-1 overflow-hidden">
      <div class="flex items-center gap-15 w-max marquee">
        {clients.map((client) => (
          typeof client.src === "string" ? (
            <img
              src={client.src}
              alt={logoAlt.replace("{name}", client.name)}
              class="h-7 w-auto max-w-36 object-contain grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all duration-300"
            />
          ) : (
            <Image
              src={client.src}
              alt={logoAlt.replace("{name}", client.name)}
              height={28}
              densities={[1, 2]}
              class="h-7 w-auto max-w-36 object-contain grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all duration-300"
            />
          )
        ))}
        {clients.map((client) => (
          typeof client.src === "string" ? (
            <img
              src={client.src}
              alt=""
              aria-hidden="true"
              class="h-7 w-auto max-w-36 object-contain grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all duration-300"
            />
          ) : (
            <Image
              src={client.src}
              alt=""
              aria-hidden="true"
              height={28}
              densities={[1, 2]}
              class="h-7 w-auto max-w-36 object-contain grayscale opacity-60 hover:opacity-100 hover:grayscale-0 transition-all duration-300"
            />
          )
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .marquee {
    animation: marquee 30s linear infinite;
  }
</style>

---
import { useTranslations, type Locale } from '@/i18n/utils';
import ServicesHeadlineReact from './ServicesHeadlineReact';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const headline = t('services', 'headline') as string;
const highlight1 = t('services', 'headlineHighlight1') as string;
const highlight2 = t('services', 'headlineHighlight2') as string;
const sectionLabel = t('services', 'sectionLabel') as string;
---

<ServicesHeadlineReact
  headline={headline}
  highlight1={highlight1}
  highlight2={highlight2}
  sectionLabel={sectionLabel}
  client:load
/>

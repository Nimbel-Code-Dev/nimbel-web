---
import SocialIcon from "@/components/ui/SocialIcon.astro";
import { useTranslations, type Locale } from "@/i18n/utils";
import { socialNetworks } from "@/utils/socialNetworks";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const description = t("footer", "description") as string;
const nav = t("footer", "nav") as {
  title: string;
  about: string;
  services: string;
  contact: string;
  aboutNimbel: string;
};
const social = t("footer", "social") as { title: string };
const copyright = (t("footer", "copyright") as string).replace(
  "{year}",
  String(new Date().getFullYear()),
);

const privacyLink = locale === "en" ? "/en/privacidad" : "/privacidad";
const aboutNimbelLink = locale === "en" ? "/en/about-nimbel-code" : "/sobre-nimbel-code";
// Anclas de la home: con la ruta delante para que funcionen desde otras páginas
const home = locale === "en" ? "/en/" : "/";
const privacyLabel = locale === "en" ? "Privacy policy" : "Política de privacidad";
const fambaCaseLink = locale === "en" ? "/en/cases/famba/" : "/casos/famba/";
const fambaCaseLabel = locale === "en" ? "FAMBA case" : "Caso FAMBA";
---

<footer class="w-full bg-nimbel-bg">
  <!-- Main section -->
  <div class="mx-auto w-full max-w-7xl px-6 sm:px-12 lg:px-16 py-12 lg:py-16">
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-16"
    >
      <!-- Col 1: Logo + description -->
      <div>
        <img
          src="/assets/Nimbel Logo.svg"
          alt="Nimbel Code"
          class="h-8 w-auto mb-4"
        />
        <p class="text-nimbel-muted text-sm leading-relaxed max-w-xs">
          {description}
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <p
          class="font-mortend uppercase text-xs tracking-widest text-nimbel-muted mb-4"
        >
          {nav.title}
        </p>
        <ul class="flex flex-col gap-3">
          <li>
            <a
              href={`${home}#team`}
              class="text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
            >
              {nav.about}
            </a>
          </li>
          <li>
            <a
              href={`${home}#services`}
              class="text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
            >
              {nav.services}
            </a>
          </li>
          <li>
            <a
              href={`${home}#contact`}
              class="text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
            >
              {nav.contact}
            </a>
          </li>
          <li>
            <a
              href={privacyLink}
              class="text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
            >
              {privacyLabel}
            </a>
          </li>
          <li>
            <a
              href={aboutNimbelLink}
              class="text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
            >
              {nav.aboutNimbel}
            </a>
          </li>
          {
            // El blog solo existe en español por ahora
            locale === "es" && (
              <li>
                <a
                  href="/blog/"
                  class="text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
                >
                  Blog
                </a>
              </li>
            )
          }
          {
            fambaCaseLink && (
              <li>
                <a
                  href={fambaCaseLink}
                  class="text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
                >
                  {fambaCaseLabel}
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <!-- Col 3: Social -->
      <div>
        <p
          class="font-mortend uppercase text-xs tracking-widest text-nimbel-muted mb-4"
        >
          {social.title}
        </p>
        <ul class="flex flex-col gap-3">
          {
            socialNetworks.map((network) => (
              <li>
                <a
                  href={network.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-2 text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
                >
                  <SocialIcon
                    name={network.id}
                    class="w-4 h-4 text-nimbel-muted group-hover:text-nimbel-accent transition-colors shrink-0"
                  />
                  {network.label}
                </a>
              </li>
            ))
          }
          <li>
            <!-- Enlace de verificación de TechBehemoths: tiene que ser follow (sin nofollow) -->
            <a
              href="https://techbehemoths.com/company/nimbel-code"
              target="_blank"
              rel="noopener noreferrer"
              class="text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
            >
              TechBehemoths
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Separator -->
  <div class="border-t border-white/10">
    <div class="mx-auto w-full max-w-7xl px-6 sm:px-12 lg:px-16 py-6">
      <p class="text-center text-sm text-nimbel-muted">
        {copyright}
      </p>
    </div>
  </div>
</footer>

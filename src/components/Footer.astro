---
import { useTranslations, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const description = t("footer", "description") as string;
const nav = t("footer", "nav") as {
  title: string;
  about: string;
  services: string;
  contact: string;
  aboutNimbel: string;
};
const social = t("footer", "social") as { title: string };
const copyright = (t("footer", "copyright") as string).replace(
  "{year}",
  String(new Date().getFullYear()),
);

const privacyLink = locale === "en" ? "/en/privacidad" : "/privacidad";
const aboutNimbelLink = locale === "en" ? "/en/about-nimbel-code" : "/sobre-nimbel-code";
// Anclas de la home: con la ruta delante para que funcionen desde otras páginas
const home = locale === "en" ? "/en/" : "/";
const privacyLabel = locale === "en" ? "Privacy policy" : "Política de privacidad";
// Los casos solo existen en español
const fambaCaseLink = locale === "es" ? "/casos/famba/" : undefined;
---

<footer class="w-full bg-nimbel-bg">
  <!-- Main section -->
  <div class="mx-auto w-full max-w-7xl px-6 sm:px-12 lg:px-16 py-12 lg:py-16">
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-16"
    >
      <!-- Col 1: Logo + description -->
      <div>
        <img
          src="/assets/Nimbel Logo.svg"
          alt="Nimbel Code"
          class="h-8 w-auto mb-4"
        />
        <p class="text-nimbel-muted text-sm leading-relaxed max-w-xs">
          {description}
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <p
          class="font-mortend uppercase text-xs tracking-widest text-nimbel-muted mb-4"
        >
          {nav.title}
        </p>
        <ul class="flex flex-col gap-3">
          <li>
            <a
              href={`${home}#team`}
              class="text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
            >
              {nav.about}
            </a>
          </li>
          <li>
            <a
              href={`${home}#services`}
              class="text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
            >
              {nav.services}
            </a>
          </li>
          <li>
            <a
              href={`${home}#contact`}
              class="text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
            >
              {nav.contact}
            </a>
          </li>
          <li>
            <a
              href={privacyLink}
              class="text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
            >
              {privacyLabel}
            </a>
          </li>
          <li>
            <a
              href={aboutNimbelLink}
              class="text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
            >
              {nav.aboutNimbel}
            </a>
          </li>
          {
            fambaCaseLink && (
              <li>
                <a
                  href={fambaCaseLink}
                  class="text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
                >
                  Caso FAMBA
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <!-- Col 3: Social -->
      <div>
        <p
          class="font-mortend uppercase text-xs tracking-widest text-nimbel-muted mb-4"
        >
          {social.title}
        </p>
        <ul class="flex flex-col gap-3">
          <li>
            <a
              href="https://www.instagram.com/nimbelcode.tech/"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-2 text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
            >
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                class="w-4 h-4 text-nimbel-muted group-hover:text-nimbel-accent transition-colors shrink-0"
                aria-hidden="true"
              >
                <path
                  d="M12 2.163c3.204 0 3.584.012 4.85.07 1.17.054 1.805.249 2.227.415.56.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.054 1.17-.249 1.805-.413 2.227-.217.562-.477.96-.896 1.382-.42.419-.819.679-1.382.896-.422.164-1.057.36-2.227.413-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-1.17-.054-1.805-.249-2.227-.413-.562-.217-.96-.477-1.382-.896-.419-.42-.679-.819-.896-1.382-.164-.422-.36-1.057-.413-2.227-.058-1.266-.07-1.646-.07-4.85s.012-3.584.07-4.85c.054-1.17.249-1.805.413-2.227.217-.562.477-.96.896-1.381.42-.419.819-.679 1.382-.896.422-.166 1.057-.361 2.227-.415 1.266-.058 1.646-.07 4.85-.07M12 0C8.741 0 8.333.014 7.053.072 5.775.131 4.902.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.902.131 5.775.072 7.053.014 8.333 0 8.741 0 12s.014 3.668.072 4.948c.059 1.277.261 2.15.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.763.296 1.636.499 2.913.558C8.333 23.986 8.741 24 12 24s3.668-.014 4.948-.072c1.277-.059 2.15-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.763.499-1.636.558-2.913.058-1.28.072-1.689.072-4.948s-.014-3.667-.072-4.947c-.059-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.763-.297-1.636-.499-2.913-.558C15.667.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"
                ></path>
              </svg>
              Instagram
            </a>
          </li>
          <li>
            <a
              href="https://www.tiktok.com/@nimbelcode"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-2 text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
            >
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                class="w-4 h-4 text-nimbel-muted group-hover:text-nimbel-accent transition-colors shrink-0"
                aria-hidden="true"
              >
                <path
                  d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"
                ></path>
              </svg>
              TikTok
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/company/nimbel-code-apps/"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-2 text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
            >
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                class="w-4 h-4 text-nimbel-muted group-hover:text-nimbel-accent transition-colors shrink-0"
                aria-hidden="true"
              >
                <path
                  d="M7.17532 20.091V9.25352H3.69V20.091H7.17532ZM5.43339 7.773C6.64839 7.773 7.4047 6.942 7.4047 5.901C7.38294 4.8375 6.64984 4.029 5.45662 4.029C4.26339 4.029 3.48387 4.839 3.48387 5.901C3.48387 6.942 4.24016 7.773 5.41016 7.773H5.43339ZM12.5579 20.091V14.0385C12.5579 13.7145 12.5811 13.3905 12.674 13.1595C12.9252 12.513 13.4985 11.8425 14.4624 11.8425C15.7239 11.8425 16.2276 12.8355 16.2276 14.2935V20.091H19.7129V13.875C19.7129 10.545 17.9942 8.99704 15.7006 8.99704C13.8513 8.99704 13.0224 10.047 12.5579 10.7865V10.824H12.5347L12.5579 10.7865V9.25352H9.07401C9.1176 10.2705 9.07401 20.091 9.07401 20.091H12.5579Z"
                ></path>
              </svg>
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href="https://github.com/Nimbel-Code-Dev"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-2 text-nimbel-text text-sm hover:text-nimbel-accent transition-colors"
            >
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                class="w-4 h-4 text-nimbel-muted group-hover:text-nimbel-accent transition-colors shrink-0"
                aria-hidden="true"
              >
                <path
                  d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"
                ></path>
              </svg>
              GitHub
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Separator -->
  <div class="border-t border-white/10">
    <div class="mx-auto w-full max-w-7xl px-6 sm:px-12 lg:px-16 py-6">
      <p class="text-center text-sm text-nimbel-muted">
        {copyright}
      </p>
    </div>
  </div>
</footer>

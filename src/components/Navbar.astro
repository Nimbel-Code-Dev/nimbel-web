---
import { useTranslations, type Locale } from "@/i18n/utils";
import MobileMenu from "./MobileMenu.astro";

export type Props = {
  currentPage?: string;
  locale: Locale;
};

const { currentPage, locale } = Astro.props;
const t = useTranslations(locale);

const navLinks = [
  { label: t("navbar", "about"), href: "#about" },
  { label: t("navbar", "services"), href: "#services" },
];
---

<nav class="flex items-center justify-between px-15 py-5 relative max-md:px-6">
  <!-- Logo -->
  <img src="/assets/Nimbel Logo.svg" alt="Nimbel" class="h-10 w-auto" width="40" height="40" />

  <!-- Desktop: Links + CTA -->
  <div class="hidden md:flex gap-4 items-center">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="text-nimbel-muted text-base px-1 py-1 whitespace-nowrap"
          aria-current={currentPage === link.href ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <a href="/agenda" class="btn-secondary">
      {t("navbar", "cta")}
    </a>
  </div>

  <!-- Mobile: Hamburger button -->
  <button
    id="menu-toggle"
    class="md:hidden flex flex-col gap-1.25 p-2 cursor-pointer"
    aria-label="Abrir menú"
    aria-expanded="false"
  >
    <span
      class="hamburger-line block w-6 h-0.5 bg-nimbel-muted transition-all duration-300"
    ></span>
    <span
      class="hamburger-line block w-6 h-0.5 bg-nimbel-muted transition-all duration-300"
    ></span>
    <span
      class="hamburger-line block w-6 h-0.5 bg-nimbel-muted transition-all duration-300"
    ></span>
  </button>
</nav>

<MobileMenu navLinks={navLinks} locale={locale} />

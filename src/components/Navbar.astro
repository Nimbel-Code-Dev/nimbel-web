---
import { useTranslations, type Locale } from "@/i18n/utils";
import MobileMenu from "./MobileMenu.astro";

export type Props = {
  currentPage?: string;
  locale: Locale;
};

const { currentPage, locale } = Astro.props;
const t = useTranslations(locale);

const navLinks = [
  { label: t("navbar", "about"), href: "#team" },
  { label: t("navbar", "services"), href: "#services" },
];

const pathname = Astro.url.pathname;
const alternateUrl =
  locale === "es"
    ? `/en${pathname === "/" ? "" : pathname}`
    : pathname.replace(/^\/en/, "") || "/";
---

<nav class="flex items-center justify-between px-15 py-5 relative max-md:px-6">
  <!-- Logo -->
  <a href={locale === "en" ? "/en" : "/"} aria-label={locale === "en" ? "Nimbel Code — home" : "Nimbel Code — inicio"}>
    <img src="/assets/Nimbel Logo.svg" alt="Nimbel" class="h-10 w-auto" width="40" height="40" />
  </a>

  <!-- Desktop: Links + CTA + Lang switcher -->
  <div class="hidden md:flex gap-4 items-center">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="text-nimbel-muted text-base px-1 py-1 whitespace-nowrap"
          aria-current={currentPage === link.href ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <a href="#contact" class="btn-secondary">
      {t("navbar", "cta")}
    </a>
    <!-- Language switcher -->
    <div class="flex items-center gap-1 text-sm font-medium" aria-label={locale === "en" ? "Change language" : "Cambiar idioma"}>
      {locale === "es" ? (
        <span class="text-nimbel-text" aria-current="true">ES</span>
      ) : (
        <a href={alternateUrl} class="text-nimbel-muted hover:text-nimbel-text transition-colors">ES</a>
      )}
      <span class="text-nimbel-muted/40">/</span>
      {locale === "en" ? (
        <span class="text-nimbel-text" aria-current="true">EN</span>
      ) : (
        <a href={alternateUrl} class="text-nimbel-muted hover:text-nimbel-text transition-colors">EN</a>
      )}
    </div>
  </div>

  <!-- Mobile: Hamburger button -->
  <button
    id="menu-toggle"
    class="md:hidden flex flex-col gap-1.25 p-2 cursor-pointer"
    aria-label={locale === "en" ? "Open menu" : "Abrir menú"}
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <span
      class="hamburger-line block w-6 h-0.5 bg-nimbel-muted transition-all duration-300"
    ></span>
    <span
      class="hamburger-line block w-6 h-0.5 bg-nimbel-muted transition-all duration-300"
    ></span>
    <span
      class="hamburger-line block w-6 h-0.5 bg-nimbel-muted transition-all duration-300"
    ></span>
  </button>
</nav>

<MobileMenu navLinks={navLinks} locale={locale} currentPage={currentPage} />

---
import { useTranslations, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const stats = t("stats", "items") as ReadonlyArray<{
  value: number;
  label: string;
}>;
---

<section
  class="w-full bg-nimbel-stats py-12 sm:py-16 md:py-20 lg:py-24"
  aria-label={t("stats", "ariaLabel") as string}
  data-testid="stats-section"
  id="stats-section"
>
  <div class="mx-auto w-full max-w-9xl px-8 sm:px-12 lg:px-16">
    <div
      class="flex flex-col items-center gap-12 sm:flex-row sm:justify-evenly"
    >
      {
        stats.map((stat) => (
          <div
            class="flex flex-col items-center text-center"
            data-testid={`stat-item-${stat.value}`}
          >
            <span
              class="font-mortend font-bold text-6xl sm:text-7xl lg:text-8xl text-white leading-none tabular-nums"
              aria-hidden="true"
              data-stat-target={stat.value}
            >
              0
            </span>
            <p class="mt-3 font-mortend text-sm sm:text-base text-white uppercase tracking-widest leading-snug">
              {stat.label}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Accessible fallback: screen readers get the real value -->
{
  stats.map((stat) => (
    <span class="sr-only">
      {stat.value} {stat.label}
    </span>
  ))
}

<script>
  function easeOutCubic(t: number): number {
    return 1 - Math.pow(1 - t, 3);
  }

  function animateCount(el: HTMLElement, target: number, duration = 1600): void {
    const start = performance.now();

    function tick(now: number) {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const value = Math.round(easeOutCubic(progress) * target);
      el.textContent = String(value);

      if (progress < 1) {
        requestAnimationFrame(tick);
      } else {
        el.textContent = String(target);
      }
    }

    requestAnimationFrame(tick);
  }

  function initStats() {
    const section = document.getElementById("stats-section");
    if (!section) return;

    const statEls = section.querySelectorAll<HTMLElement>("[data-stat-target]");
    if (!statEls.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer.disconnect();

          statEls.forEach((el) => {
            const target = parseInt(el.dataset.statTarget ?? "0", 10);
            animateCount(el, target);
          });
        });
      },
      { threshold: 0.4 }
    );

    observer.observe(section);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initStats);
  } else {
    initStats();
  }
</script>

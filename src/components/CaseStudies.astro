---
import { getImage } from "astro:assets";
import CaseStudiesCarousel from "@/components/CaseStudiesCarousel";
import { getAsset } from "@/utils/images";
import { useTranslations, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const headline = t("caseStudies", "headline") as string;
const ariaLabel = t("caseStudies", "ariaLabel") as string;
const items = t("caseStudies", "items") as ReadonlyArray<{
  id: string;
  title: string;
  titleHighlight: string;
  description: string;
  cta: string;
  href: string;
  imgAlt: string;
}>;

// Casos con página propia
const caseLinks: Record<string, string> =
  locale === "en"
    ? { famba: "/en/cases/famba/", newsup: "/en/cases/newsup/" }
    : { famba: "/casos/famba/", newsup: "/casos/newsup/" };
// El carrusel es React: las capturas se optimizan aquí y se le pasan ya hechas
const itemsWithCase = await Promise.all(
  items.map(async (item) => {
    const img = await getImage({
      src: getAsset(`cases/${item.id}-app.png`),
      width: 1200,
      widths: [600, 1200],
    });
    return {
      ...item,
      caseHref: caseLinks[item.id],
      imgSrc: img.src,
      imgSrcSet: img.srcSet.attribute,
    };
  }),
);
---

<section
  id="casos"
  class="w-full bg-nimbel-bg py-16 sm:py-20 lg:py-24"
  aria-label={ariaLabel}
>
  <div class="mx-auto w-full max-w-7xl px-6 sm:px-12 lg:px-16">
    <h2
      class="font-mortend text-sm sm:text-base uppercase tracking-widest text-nimbel-eyebrow mb-10 sm:mb-14"
    >
      {headline}
    </h2>

    <CaseStudiesCarousel
      client:visible
      items={itemsWithCase}
      locale={locale}
    />
  </div>
</section>

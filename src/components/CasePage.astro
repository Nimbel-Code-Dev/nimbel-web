---
import { getEntry, render, type CollectionEntry } from "astro:content";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar.astro";
import type { Locale } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";

interface Props {
  caso: CollectionEntry<"casos">;
  locale: Locale;
}

const { caso, locale } = Astro.props;
const { Content, headings } = await render(caso);
const { name, title, description, datePublished } = caso.data;

// El id es "<idioma>/<slug>": /casos/<slug>/ en español y /en/cases/<slug>/ en inglés
const slug = caso.id.split("/")[1];
const casePath = (lang: Locale) => (lang === "en" ? `/en/cases/${slug}/` : `/casos/${slug}/`);
const otherLocale: Locale = locale === "en" ? "es" : "en";
const hasOther = Boolean(await getEntry("casos", `${otherLocale}/${slug}`));

const pagePath = casePath(locale);
// El español es el maestro: todo caso existe en español; el inglés, si está traducido
const alternates = {
  es: casePath("es"),
  en: locale === "en" || hasOther ? casePath("en") : undefined,
};

const siteUrl = "https://www.nimbel.net/";
const homeUrl = locale === "en" ? `${siteUrl}en/` : siteUrl;
const pageUrl = new URL(pagePath, Astro.site).href;
const organization = { "@id": `${siteUrl}#organization` };
// El headline del Article es el H1 del propio markdown
const headline = headings.find((h) => h.depth === 1)?.text ?? title;

const graph = [
  {
    "@type": "Article",
    "@id": `${pageUrl}#article`,
    mainEntityOfPage: pageUrl,
    headline,
    description,
    datePublished,
    inLanguage: locale,
    author: organization,
    publisher: organization,
    about: { "@type": "Thing", name },
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: locale === "en" ? "Home" : "Inicio", item: homeUrl },
      { "@type": "ListItem", position: 2, name: locale === "en" ? "Cases" : "Casos", item: `${homeUrl}#casos` },
      { "@type": "ListItem", position: 3, name, item: pageUrl },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  lang={locale}
  alternates={alternates}
  graph={graph}
>
  <header>
    <Navbar
      currentPage={pagePath}
      locale={locale}
      alternateUrl={hasOther ? casePath(otherLocale) : otherLocale === "en" ? "/en/" : "/"}
    />
  </header>

  <section class="w-full bg-nimbel-text">
    <article
      class="max-w-3xl mx-auto px-6 py-16 font-clash text-nimbel-bg leading-relaxed [&_h1]:font-mortend [&_h1]:uppercase [&_h1]:text-3xl [&_h1]:mb-6 [&_h2]:font-mortend [&_h2]:uppercase [&_h2]:text-xl [&_h2]:mt-10 [&_h2]:mb-4 [&_p]:mb-4 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:mb-2"
    >
      <Content />
    </article>
  </section>

  <Footer locale={locale} />
</Layout>

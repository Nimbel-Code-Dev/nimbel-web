---
import { getImage } from "astro:assets";
import backgroundSrc from "@/assets/background.png";
import "@/styles/global.css";

export type Props = {
  title?: string;
  description?: string;
  lang?: string;
  robots?: string;
  // URLs de las versiones es/en cuando no comparten slug
  alternates?: { es: string; en: string };
  // Nodos extra que se suman al @graph global
  graph?: Record<string, unknown>[];
};

const {
  title = "Nimbel CODE",
  description = "Tendrás la flexibilidad de un freelance y la seriedad de una consultora. Desarrollamos tu aplicación con calidad, personalización y a un coste razonable.",
  lang = "es",
  robots = "index, follow",
  alternates,
  graph = [],
} = Astro.props;

const backgroundDesktop = await getImage({
  src: backgroundSrc,
  format: "webp",
  quality: 35,
  width: 1440,
});

const backgroundMobile = await getImage({
  src: backgroundSrc,
  format: "webp",
  quality: 30,
  width: 640,
});

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);

const isEn = lang === "en";
const siteUrl = "https://www.nimbel.net/";
const organizationId = `${siteUrl}#organization`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "Nimbel Code",
      legalName: "NIMBEL CODE LIMITED",
      alternateName: ["Nimbel", "Nimbel Code Apps"],
      identifier: {
        "@type": "PropertyValue",
        propertyID: "CRO",
        value: "788569",
        description: "Companies Registration Office, Ireland",
      },
      url: siteUrl,
      logo: {
        "@type": "ImageObject",
        url: `${siteUrl}assets/nimbel-logo.png`,
        width: 512,
        height: 512,
      },
      foundingDate: "2020",
      numberOfEmployees: {
        "@type": "QuantitativeValue",
        minValue: 2,
        maxValue: 9,
      },
      description: isEn
        ? "Nimbel Code builds custom software with integrated AI: web apps, mobile apps and digital platforms that businesses own."
        : "Nimbel Code desarrolla software a medida con IA integrada: aplicaciones web, móviles y plataformas digitales propias para empresas.",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Unit 2, 2 Bridge Street",
        addressLocality: "Athlone",
        addressRegion: "Co. Westmeath",
        postalCode: "N37 F1W4",
        addressCountry: "IE",
      },
      location: {
        "@type": "Place",
        name: "Barcelona",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Barcelona",
          addressRegion: "Cataluña",
          addressCountry: "ES",
        },
      },
      areaServed: [
        { "@type": "Country", name: "ES" },
        { "@type": "Country", name: "MX" },
        { "@type": "Country", name: "CO" },
        { "@type": "Country", name: "AR" },
      ],
      contactPoint: {
        "@type": "ContactPoint",
        telephone: "+34 666 969 374",
        email: "ruben@nimbel.net",
        contactType: "sales",
        availableLanguage: ["es", "en"],
      },
      founder: {
        "@type": "Person",
        "@id": `${siteUrl}#ruben`,
        name: "Rubén Sahagún",
        jobTitle: "Founder & CEO",
        sameAs: ["https://www.linkedin.com/in/ruben1"],
      },
      knowsAbout: isEn
        ? [
            "Custom software development",
            "Artificial intelligence",
            "Web applications",
            "Mobile applications",
            "UX/UI design",
          ]
        : [
            "Desarrollo de software a medida",
            "Inteligencia artificial",
            "Aplicaciones web",
            "Aplicaciones móviles",
            "Diseño UX/UI",
          ],
      sameAs: [
        "https://www.linkedin.com/company/nimbel-code-apps/",
        "https://github.com/Nimbel-Code-Dev",
        "https://www.instagram.com/nimbelcode.tech/",
        "https://www.tiktok.com/@nimbelcode",
        "https://www.crunchbase.com/organization/nimbel",
        "https://clutch.co/profile/nimbel-code",
        "https://www.goodfirms.co/company/nimbel-code",
        "https://maps.google.com/?cid=1064071797735352286",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "Nimbel Code",
      publisher: { "@id": organizationId },
      inLanguage: ["es", "en"],
    },
    ...graph,
  ],
};

const hreflangEs = alternates
  ? new URL(alternates.es, Astro.site)
  : lang === "es"
    ? canonicalURL
    : new URL(Astro.url.pathname.replace(/^\/en/, "") || "/", Astro.site);
const hreflangEn = alternates
  ? new URL(alternates.en, Astro.site)
  : lang === "en"
    ? canonicalURL
    : new URL(
        `/en${Astro.url.pathname === "/" ? "/" : Astro.url.pathname}`,
        Astro.site,
      );
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <title>{title}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang -->
    <link rel="alternate" hreflang="es" href={hreflangEs} />
    <link rel="alternate" hreflang="en" href={hreflangEn} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL("/", Astro.site)}
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Nimbel Code" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_ES"} />
    <meta
      property="og:locale:alternate"
      content={lang === "en" ? "es_ES" : "en_US"}
    />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!-- Start of HubSpot Embed Code -->
    <script
      type="text/javascript"
      id="hs-script-loader"
      async
      defer
      src="//js.hs-scripts.com/51196399.js"></script>
    <!-- End of HubSpot Embed Code -->

    <!-- Fonts -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Preload critical assets -->
    <link
      rel="preload"
      as="image"
      href={backgroundDesktop.src}
      fetchpriority="high"
      media="(min-width: 768px)"
    />
    <link
      rel="preload"
      as="image"
      href={backgroundMobile.src}
      fetchpriority="high"
      media="(max-width: 767px)"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/mortend-mortend-regular-400.woff2"
      crossorigin
    />

    <style
      define:vars={{
        backgroundDesktop: `url(${backgroundDesktop.src})`,
        backgroundMobile: `url(${backgroundMobile.src})`,
      }}
    >
      @media (max-width: 767px) {
        body {
          background-image: var(--backgroundMobile);
        }
      }
      @media (min-width: 768px) {
        body {
          background-image: var(--backgroundDesktop);
        }
      }
    </style>

    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap"
      />
    </noscript>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-nimbel-accent focus:text-white focus:rounded focus:font-medium"
    >
      {lang === "en" ? "Skip to main content" : "Ir al contenido principal"}
    </a>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
